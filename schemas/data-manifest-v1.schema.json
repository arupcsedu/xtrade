{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis-mx.invalid/schemas/data-manifest-v1.schema.json",
  "title": "Aegis-MX immutable POC data manifest v1",
  "oneOf": [
    {"$ref": "#/$defs/sourceEnvelope"},
    {"$ref": "#/$defs/partitionEnvelope"}
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^(?!0{64}$)[a-f0-9]{64}$"
    },
    "manifestId": {
      "type": "string",
      "pattern": "^(source|partition)-[a-f0-9]{64}$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[^\\u0000]+$"
    },
    "storagePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(quarantine|raw|canonical|derived|datasets|models|reports)/[^\\u0000\\\\]+$"
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parent_manifest_id", "relation", "reason"],
      "properties": {
        "parent_manifest_id": {
          "oneOf": [{"$ref": "#/$defs/manifestId"}, {"type": "null"}]
        },
        "relation": {"enum": ["NONE", "CORRECTS", "REPLACES"]},
        "reason": {
          "oneOf": [{"$ref": "#/$defs/identifier"}, {"type": "null"}]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"relation": {"const": "NONE"}}},
          "then": {
            "properties": {
              "parent_manifest_id": {"type": "null"},
              "reason": {"type": "null"}
            }
          }
        },
        {
          "if": {
            "properties": {"relation": {"enum": ["CORRECTS", "REPLACES"]}}
          },
          "then": {
            "properties": {
              "parent_manifest_id": {"$ref": "#/$defs/manifestId"},
              "reason": {"$ref": "#/$defs/identifier"}
            }
          }
        }
      ]
    },
    "times": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_time_max_ns",
        "event_time_min_ns",
        "processing_time_max_ns",
        "processing_time_min_ns",
        "publication_time_max_ns",
        "publication_time_min_ns",
        "receive_time_max_ns",
        "receive_time_min_ns",
        "revision_time_max_ns",
        "revision_time_min_ns"
      ],
      "properties": {
        "event_time_max_ns": {"type": "integer", "minimum": 0},
        "event_time_min_ns": {"type": "integer", "minimum": 0},
        "processing_time_max_ns": {"type": "integer", "minimum": 0},
        "processing_time_min_ns": {"type": "integer", "minimum": 0},
        "publication_time_max_ns": {"type": "integer", "minimum": 0},
        "publication_time_min_ns": {"type": "integer", "minimum": 0},
        "receive_time_max_ns": {"type": "integer", "minimum": 0},
        "receive_time_min_ns": {"type": "integer", "minimum": 0},
        "revision_time_max_ns": {"type": "integer", "minimum": 0},
        "revision_time_min_ns": {"type": "integer", "minimum": 0}
      }
    },
    "commonPayloadProperties": {
      "type": "object",
      "properties": {
        "lineage": {"$ref": "#/$defs/lineage"},
        "object_sha256": {"$ref": "#/$defs/sha256"},
        "record_count": {"type": "integer", "minimum": 0},
        "schema_name": {"$ref": "#/$defs/identifier"},
        "schema_version": {"$ref": "#/$defs/identifier"},
        "size_bytes_decimal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "storage_path": {"$ref": "#/$defs/storagePath"},
        "times": {"$ref": "#/$defs/times"},
        "universe_snapshot_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "sourcePayload": {
      "allOf": [
        {"$ref": "#/$defs/commonPayloadProperties"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lineage",
            "object_sha256",
            "record_count",
            "schema_name",
            "schema_version",
            "size_bytes_decimal",
            "source_name",
            "source_object_id",
            "source_version",
            "storage_path",
            "times",
            "universe_snapshot_sha256"
          ],
          "properties": {
            "lineage": {"$ref": "#/$defs/lineage"},
            "object_sha256": {"$ref": "#/$defs/sha256"},
            "record_count": {"type": "integer", "minimum": 0},
            "schema_name": {"$ref": "#/$defs/identifier"},
            "schema_version": {"$ref": "#/$defs/identifier"},
            "size_bytes_decimal": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "source_name": {"$ref": "#/$defs/identifier"},
            "source_object_id": {"$ref": "#/$defs/identifier"},
            "source_version": {"$ref": "#/$defs/identifier"},
            "storage_path": {"$ref": "#/$defs/storagePath"},
            "times": {"$ref": "#/$defs/times"},
            "universe_snapshot_sha256": {"$ref": "#/$defs/sha256"}
          }
        }
      ]
    },
    "partitionPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_name",
        "lineage",
        "object_sha256",
        "partition_key",
        "record_count",
        "schema_name",
        "schema_version",
        "size_bytes_decimal",
        "source_manifest_ids",
        "storage_path",
        "times",
        "universe_snapshot_sha256"
      ],
      "properties": {
        "dataset_name": {"$ref": "#/$defs/identifier"},
        "lineage": {"$ref": "#/$defs/lineage"},
        "object_sha256": {"$ref": "#/$defs/sha256"},
        "partition_key": {"$ref": "#/$defs/identifier"},
        "record_count": {"type": "integer", "minimum": 0},
        "schema_name": {"$ref": "#/$defs/identifier"},
        "schema_version": {"$ref": "#/$defs/identifier"},
        "size_bytes_decimal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "source_manifest_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^source-[a-f0-9]{64}$"}
        },
        "storage_path": {"$ref": "#/$defs/storagePath"},
        "times": {"$ref": "#/$defs/times"},
        "universe_snapshot_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "sourceEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_id",
        "manifest_schema_version",
        "manifest_sha256",
        "manifest_type",
        "payload"
      ],
      "properties": {
        "manifest_id": {"type": "string", "pattern": "^source-[a-f0-9]{64}$"},
        "manifest_schema_version": {"const": "1.0.0"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "manifest_type": {"const": "SOURCE"},
        "payload": {"$ref": "#/$defs/sourcePayload"}
      }
    },
    "partitionEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_id",
        "manifest_schema_version",
        "manifest_sha256",
        "manifest_type",
        "payload"
      ],
      "properties": {
        "manifest_id": {
          "type": "string",
          "pattern": "^partition-[a-f0-9]{64}$"
        },
        "manifest_schema_version": {"const": "1.0.0"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "manifest_type": {"const": "PARTITION"},
        "payload": {"$ref": "#/$defs/partitionPayload"}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis-mx.invalid/schemas/alfred-approval-v1.schema.json",
  "title": "Aegis-MX owner-only ALFRED approval v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["allowed_series", "api_execution_authorized", "approval_id", "approval_sha256", "contains_secrets", "derived_data_authorized", "distribution", "expires_at_utc", "model_training_authorized", "persistent_storage_authorized", "schema_version", "source_id", "storage_limit_bytes_decimal", "use_classification", "valid_from", "valid_through"],
  "properties": {
    "allowed_series": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["CPIAUCSL", "PPIACO", "PAYEMS", "GDP", "RSAFS", "DFEDTARU", "DFEDTARL"]}},
    "api_execution_authorized": {"type": "boolean"},
    "approval_id": {"type": "string", "minLength": 3, "maxLength": 128},
    "approval_sha256": {"$ref": "#/$defs/sha256"},
    "contains_secrets": {"const": false},
    "derived_data_authorized": {"const": true},
    "distribution": {"const": "OWNER_ONLY_INTERNAL"},
    "expires_at_utc": {"type": "string", "format": "date-time"},
    "model_training_authorized": {"const": true},
    "persistent_storage_authorized": {"const": true},
    "schema_version": {"const": "1.0.0"},
    "source_id": {"const": "fred_alfred_selected_series"},
    "storage_limit_bytes_decimal": {"type": "integer", "minimum": 1, "maximum": 999000000},
    "use_classification": {"const": "ACADEMIC_NON_COMMERCIAL"},
    "valid_from": {"type": "string", "format": "date"},
    "valid_through": {"type": "string", "format": "date"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis-mx.invalid/schemas/canonical-minute-record-v1.schema.json",
  "title": "Aegis-MX canonical point-in-time minute record v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["close_ticks", "corporate_action_ids", "currency", "data_quality_reasons", "data_quality_state", "high_ticks", "instrument_id", "instrument_revision_id", "local_processing_time_ns", "local_receipt_time_ns", "low_ticks", "mapping_id", "market_id", "minute_end_exchange_time_ns", "minute_start_exchange_time_ns", "open_ticks", "price_unit", "quantity_unit", "record_sha256", "reference_sha256", "schema_version", "session_close_exchange_time_ns", "session_id", "session_open_exchange_time_ns", "source_availability_time_ns", "source_manifest_id", "source_object_id", "source_publication_time_ns", "source_record_id", "source_ticker", "tick_revision_id", "tick_value_currency_nanos", "trade_count", "trading_date", "volume_shares", "vwap_ticks"],
  "properties": {
    "close_ticks": {"$ref": "#/$defs/positiveInt64"},
    "corporate_action_ids": {"$ref": "#/$defs/uniqueIdentifiers"},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "data_quality_reasons": {"$ref": "#/$defs/uniqueIdentifiers"},
    "data_quality_state": {"enum": ["VALID", "DEGRADED"]},
    "high_ticks": {"$ref": "#/$defs/positiveInt64"},
    "instrument_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "instrument_revision_id": {"$ref": "#/$defs/identifier"},
    "local_processing_time_ns": {"$ref": "#/$defs/positiveInt64"},
    "local_receipt_time_ns": {"$ref": "#/$defs/positiveInt64"},
    "low_ticks": {"$ref": "#/$defs/positiveInt64"},
    "mapping_id": {"$ref": "#/$defs/identifier"},
    "market_id": {"$ref": "#/$defs/identifier"},
    "minute_end_exchange_time_ns": {"$ref": "#/$defs/positiveInt64"},
    "minute_start_exchange_time_ns": {"$ref": "#/$defs/positiveInt64"},
    "open_ticks": {"$ref": "#/$defs/positiveInt64"},
    "price_unit": {"const": "TICKS"},
    "quantity_unit": {"const": "SHARES"},
    "record_sha256": {"$ref": "#/$defs/sha256"},
    "reference_sha256": {"$ref": "#/$defs/sha256"},
    "schema_version": {"const": "1.0.0"},
    "session_close_exchange_time_ns": {"$ref": "#/$defs/positiveInt64"},
    "session_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "session_open_exchange_time_ns": {"$ref": "#/$defs/positiveInt64"},
    "source_availability_time_ns": {"$ref": "#/$defs/positiveInt64"},
    "source_manifest_id": {"type": "string", "pattern": "^source-[0-9a-f]{64}$"},
    "source_object_id": {"$ref": "#/$defs/identifier"},
    "source_publication_time_ns": {"oneOf": [{"$ref": "#/$defs/positiveInt64"}, {"type": "null"}]},
    "source_record_id": {"$ref": "#/$defs/identifier"},
    "source_ticker": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:[.-][A-Z0-9]+)?$", "maxLength": 32},
    "tick_revision_id": {"$ref": "#/$defs/identifier"},
    "tick_value_currency_nanos": {"$ref": "#/$defs/positiveInt64"},
    "trade_count": {"oneOf": [{"$ref": "#/$defs/nonnegativeInt64"}, {"type": "null"}]},
    "trading_date": {"type": "string", "format": "date"},
    "volume_shares": {"$ref": "#/$defs/nonnegativeInt64"},
    "vwap_ticks": {"oneOf": [{"$ref": "#/$defs/positiveInt64"}, {"type": "null"}]}
  },
  "$defs": {
    "identifier": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000]+$"},
    "nonnegativeInt64": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "positiveInt64": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "uniqueIdentifiers": {"type": "array", "items": {"$ref": "#/$defs/identifier"}, "uniqueItems": true}
  }
}

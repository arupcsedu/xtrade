{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis-mx.invalid/schemas/training-readiness-report-v1.schema.json",
  "title": "Aegis-MX bounded forecasting training readiness report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "assessment_id",
    "report_sha256",
    "status",
    "blocking_reasons",
    "warnings",
    "authorization",
    "dataset",
    "coverage",
    "model_ready_coverage",
    "training_input_policy",
    "code_provenance",
    "whole_universe_missing_sessions",
    "external_dependencies",
    "economic_value_claimed",
    "live_trading_capable"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "assessment_id": {"$ref": "#/$defs/sha256"},
    "report_sha256": {"$ref": "#/$defs/sha256"},
    "status": {"enum": ["READY_FOR_INFRASTRUCTURE_VALIDATION", "BLOCKED"]},
    "blocking_reasons": {"$ref": "#/$defs/reasons"},
    "warnings": {"$ref": "#/$defs/reasons"},
    "economic_value_claimed": {"const": false},
    "live_trading_capable": {"const": false},
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approval_id",
        "authorization_valid",
        "checked_at_utc",
        "expires_at_utc",
        "model_training_authorized",
        "source_approval_sha256"
      ],
      "properties": {
        "approval_id": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 256
        },
        "authorization_valid": {"type": "boolean"},
        "checked_at_utc": {"type": "string", "format": "date-time"},
        "expires_at_utc": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "model_training_authorized": {"type": "boolean"},
        "source_approval_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "whole_universe_missing_sessions": {
      "type": "array",
      "maxItems": 1000,
      "items": {"type": "string", "format": "date"}
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_id",
        "manifest_sha256",
        "leakage_status",
        "object_count",
        "sample_count",
        "session_summary_count",
        "checked_bytes_decimal"
      ],
      "properties": {
        "dataset_id": {"$ref": "#/$defs/sha256"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "leakage_status": {"enum": ["PASS", "REJECTED"]},
        "object_count": {"type": "integer", "minimum": 1, "maximum": 40000},
        "sample_count": {"type": "integer", "minimum": 1},
        "session_summary_count": {"type": "integer", "minimum": 1},
        "checked_bytes_decimal": {"type": "integer", "minimum": 0, "maximum": 100000000000}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coverage_rows",
        "eligible_symbols",
        "abstaining_symbols",
        "valid_labels",
        "missing_labels",
        "invalid_labels",
        "minimum_valid_labels_per_resolved_symbol_horizon",
        "per_horizon"
      ],
      "properties": {
        "coverage_rows": {"type": "integer", "minimum": 12, "maximum": 12000},
        "eligible_symbols": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/ticker"}
        },
        "abstaining_symbols": {
          "type": "array",
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/ticker"}
        },
        "valid_labels": {"type": "integer", "minimum": 1},
        "missing_labels": {"type": "integer", "minimum": 0},
        "invalid_labels": {"type": "integer", "minimum": 0},
        "minimum_valid_labels_per_resolved_symbol_horizon": {"type": "integer", "minimum": 1},
        "per_horizon": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["horizon", "valid", "minimum_valid_per_resolved_symbol"],
            "properties": {
              "horizon": {"enum": ["5m", "10m", "15m", "30m", "60m", "2h", "5h", "1d", "1w", "2w", "1mo", "2mo"]},
              "valid": {"type": "integer", "minimum": 1},
              "minimum_valid_per_resolved_symbol": {"type": "integer", "minimum": 1}
            }
          }
        }
      }
    },
    "model_ready_coverage": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scanned_feature_rows",
            "feature_complete_rows_by_split",
            "minimum_pooled_training_rows_per_horizon",
            "minimum_pooled_training_symbols_per_horizon",
            "observed_quality_reason_codes",
            "per_horizon"
          ],
          "properties": {
            "scanned_feature_rows": {"type": "integer", "minimum": 1},
            "minimum_pooled_training_rows_per_horizon": {"type": "integer", "minimum": 1},
            "minimum_pooled_training_symbols_per_horizon": {"type": "integer", "minimum": 1},
            "observed_quality_reason_codes": {"$ref": "#/$defs/reasons"},
            "feature_complete_rows_by_split": {
              "type": "object",
              "additionalProperties": false,
              "required": ["TRAIN", "VALIDATION", "TEST"],
              "properties": {
                "TRAIN": {"type": "integer", "minimum": 1},
                "VALIDATION": {"type": "integer", "minimum": 1},
                "TEST": {"type": "integer", "minimum": 1}
              }
            },
            "per_horizon": {
              "type": "array",
              "minItems": 12,
              "maxItems": 12,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "horizon",
                  "training_rows",
                  "validation_rows",
                  "test_rows",
                  "contributing_training_symbols",
                  "noncontributing_training_symbols"
                ],
                "properties": {
                  "horizon": {"enum": ["5m", "10m", "15m", "30m", "60m", "2h", "5h", "1d", "1w", "2w", "1mo", "2mo"]},
                  "training_rows": {"type": "integer", "minimum": 0},
                  "validation_rows": {"type": "integer", "minimum": 0},
                  "test_rows": {"type": "integer", "minimum": 0},
                  "contributing_training_symbols": {"type": "integer", "minimum": 0, "maximum": 1000},
                  "noncontributing_training_symbols": {
                    "type": "array", "maxItems": 1000, "uniqueItems": true,
                    "items": {"$ref": "#/$defs/ticker"}
                  }
                }
              }
            }
          }
        }
      ]
    },
    "training_input_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose",
        "selected_features",
        "feature_vector_indices",
        "excluded_features",
        "missing_value_policy",
        "allowed_feature_validity",
        "allowed_quality_reason_codes",
        "unsupported_symbol_policy"
      ],
      "properties": {
        "purpose": {"const": "INFRASTRUCTURE_VALIDATION_ONLY"},
        "selected_features": {
          "type": "array", "minItems": 1, "maxItems": 22, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 128}
        },
        "feature_vector_indices": {
          "type": "array", "minItems": 1, "maxItems": 22, "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0, "maximum": 21}
        },
        "excluded_features": {
          "type": "array", "maxItems": 22,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["feature_name", "reason_codes"],
            "properties": {
              "feature_name": {"type": "string", "minLength": 1, "maxLength": 128},
              "reason_codes": {"$ref": "#/$defs/reasons"}
            }
          }
        },
        "missing_value_policy": {"const": "DROP_SAMPLE_WHEN_SELECTED_FEATURE_OR_LABEL_IS_NULL"},
        "allowed_feature_validity": {
          "type": "array", "const": ["DEGRADED"]
        },
        "allowed_quality_reason_codes": {"$ref": "#/$defs/reasons"},
        "unsupported_symbol_policy": {"const": "ABSTAIN"}
      }
    },
    "code_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "git_commit",
        "worktree_dirty",
        "worktree_status_sha256",
        "source_bundle_sha256",
        "dependency_lock_sha256",
        "source_files"
      ],
      "properties": {
        "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "worktree_dirty": {"type": "boolean"},
        "worktree_status_sha256": {"$ref": "#/$defs/sha256"},
        "source_bundle_sha256": {"$ref": "#/$defs/sha256"},
        "dependency_lock_sha256": {"$ref": "#/$defs/sha256"},
        "source_files": {
          "type": "array", "minItems": 1, "maxItems": 128,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": {"type": "string", "minLength": 1, "maxLength": 512},
              "sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        }
      }
    },
    "external_dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alpaca_api_or_network_required_for_training",
        "alpaca_data_authorization_bound",
        "alpaca_source_approval_sha256",
        "alpaca_source_policy_sha256",
        "alfred_required_for_selected_features",
        "gdelt_required_for_selected_features",
        "sector_source_required_for_selected_features"
      ],
      "properties": {
        "alpaca_api_or_network_required_for_training": {"const": false},
        "alpaca_data_authorization_bound": {"const": true},
        "alpaca_source_approval_sha256": {"$ref": "#/$defs/sha256"},
        "alpaca_source_policy_sha256": {
          "oneOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        },
        "alfred_required_for_selected_features": {"const": false},
        "gdelt_required_for_selected_features": {"const": false},
        "sector_source_required_for_selected_features": {"const": false}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {"const": "READY_FOR_INFRASTRUCTURE_VALIDATION"}
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "blocking_reasons": {"maxItems": 0},
          "authorization": {
            "properties": {
              "approval_id": {"type": "string"},
              "authorization_valid": {"const": true},
              "expires_at_utc": {"type": "string"},
              "model_training_authorized": {"const": true}
            }
          },
          "model_ready_coverage": {"type": "object"},
          "code_provenance": {
            "properties": {"worktree_dirty": {"const": false}}
          },
          "dataset": {
            "properties": {"checked_bytes_decimal": {"minimum": 1}}
          },
          "external_dependencies": {
            "properties": {
              "alpaca_source_policy_sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ticker": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:[.-][A-Z0-9]+)?$", "maxLength": 16},
    "reasons": {
      "type": "array", "maxItems": 256, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 256}
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis-mx.invalid/schemas/live-mode-disabled-evidence-v1.schema.json",
  "title": "Aegis-MX live-mode-disabled evidence",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "generated_at_wall_utc",
    "source_revision",
    "build",
    "operator_simulation",
    "edge_profiles",
    "checks",
    "open_production_blockers",
    "live_mode_enabled",
    "production_activation_performed",
    "production_ready",
    "activation_status",
    "limitations",
    "passed"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "live_mode_disabled_evidence"},
    "generated_at_wall_utc": {"type": "string", "minLength": 1},
    "source_revision": {"type": "string", "minLength": 1},
    "build": {
      "type": "object",
      "required": [
        "metadata_path",
        "metadata_sha256",
        "build_type",
        "live_trading_capable"
      ],
      "properties": {
        "metadata_path": {"type": "string", "minLength": 1},
        "metadata_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "build_type": {"type": "string", "minLength": 1},
        "live_trading_capable": {"const": false}
      },
      "additionalProperties": false
    },
    "operator_simulation": {
      "type": "object",
      "required": ["report_path", "report_sha256", "audit_path", "audit_sha256"],
      "properties": {
        "report_path": {"type": "string", "minLength": 1},
        "report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "audit_path": {"type": "string", "minLength": 1},
        "audit_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "edge_profiles": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "name",
          "sha256",
          "trading_mode",
          "live_transmission_enabled",
          "automatic_activation",
          "safe"
        ],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "trading_mode": {"enum": ["SIMULATION", "PAPER"]},
          "live_transmission_enabled": {"const": false},
          "automatic_activation": {"const": false},
          "safe": {"const": true}
        },
        "additionalProperties": false
      }
    },
    "checks": {
      "type": "object",
      "required": [
        "cmake_default_live_option_off",
        "configured_build_live_option_off",
        "build_metadata_live_capability_false",
        "all_edge_profiles_non_live",
        "gateway_unit_has_disabled_live_guard",
        "control_plane_rejects_live_mode",
        "operator_simulation_paper_only",
        "operator_audit_extract_hash_matches"
      ],
      "properties": {
        "cmake_default_live_option_off": {"const": true},
        "configured_build_live_option_off": {"const": true},
        "build_metadata_live_capability_false": {"const": true},
        "all_edge_profiles_non_live": {"const": true},
        "gateway_unit_has_disabled_live_guard": {"const": true},
        "control_plane_rejects_live_mode": {"const": true},
        "operator_simulation_paper_only": {"const": true},
        "operator_audit_extract_hash_matches": {"const": true}
      },
      "additionalProperties": false
    },
    "open_production_blockers": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^PRD-B[0-9]{3}$"}
    },
    "live_mode_enabled": {"const": false},
    "production_activation_performed": {"const": false},
    "production_ready": {"const": false},
    "activation_status": {"const": "PROHIBITED"},
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "passed": {"const": true}
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis-mx.invalid/schemas/gdelt-metadata-record-v1.schema.json",
  "title": "Aegis-MX bounded GDELT metadata record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "advisory_event_id",
    "advisory_only",
    "attribution",
    "content_sha256",
    "contradicts_provider_ids",
    "event_type",
    "instrument_ids",
    "live_trading_capable",
    "organizations",
    "processing_time_utc_ns",
    "provider_observation_time_semantics",
    "provider_observation_time_utc_ns",
    "provider_record_id",
    "publication_date",
    "publication_time_reason",
    "publication_time_utc_ns",
    "publisher_content_fetched",
    "publisher_full_text_stored",
    "receipt_time_utc_ns",
    "schema_version",
    "source_common_name",
    "source_language",
    "source_url",
    "source_url_sha256",
    "themes",
    "tickers",
    "uncertainty_ppm"
  ],
  "properties": {
    "advisory_event_id": {"type": ["string", "null"], "maxLength": 80},
    "advisory_only": {"const": true},
    "attribution": {"const": "Data source: The GDELT Project (https://www.gdeltproject.org/)"},
    "content_sha256": {"$ref": "#/$defs/sha256"},
    "contradicts_provider_ids": {"type": "array", "maxItems": 32, "items": {"type": "string", "maxLength": 128}},
    "event_type": {"type": ["string", "null"], "enum": [null, "EARNINGS_RELEASE", "GUIDANCE_UPDATE", "MERGER_ACQUISITION", "PRODUCT_RECALL", "REGULATORY_ACTION", "EXECUTIVE_CHANGE", "FINANCING", "BANKRUPTCY", "LITIGATION", "CYBERSECURITY_INCIDENT", "SUPPLY_CHAIN_DISRUPTION", "TRADING_HALT", "RUMOR", "CORRECTION"]},
    "instrument_ids": {"type": "array", "minItems": 1, "maxItems": 79, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{32}$"}},
    "live_trading_capable": {"const": false},
    "organizations": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"type": "string", "maxLength": 256}},
    "processing_time_utc_ns": {"type": "integer", "minimum": 1},
    "provider_observation_time_semantics": {"const": "GDELT_GKG_DATE"},
    "provider_observation_time_utc_ns": {"type": "integer", "minimum": 1},
    "provider_record_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "publication_date": {"type": "null"},
    "publication_time_reason": {"const": "PRECISE_TIME_NOT_ASSERTED_BY_ADAPTER"},
    "publication_time_utc_ns": {"type": "null"},
    "publisher_content_fetched": {"const": false},
    "publisher_full_text_stored": {"const": false},
    "receipt_time_utc_ns": {"type": "integer", "minimum": 1},
    "schema_version": {"const": "1.0.0"},
    "source_common_name": {"type": "string", "minLength": 1, "maxLength": 256},
    "source_language": {"type": "string", "pattern": "^(?:[a-z]{3}|und)$"},
    "source_url": {"type": "string", "pattern": "^https?://", "maxLength": 2048},
    "source_url_sha256": {"$ref": "#/$defs/sha256"},
    "themes": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,127}$"}},
    "tickers": {"type": "array", "minItems": 1, "maxItems": 79, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:[.-][A-Z0-9]+)?$"}},
    "uncertainty_ppm": {"type": "integer", "minimum": 0, "maximum": 1000000}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis-mx.invalid/schemas/derived-session-summary-v1.schema.json",
  "title": "Aegis-MX minute-derived session summary v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "instrument_id", "source_ticker", "session_id", "trading_date", "open_ticks", "high_ticks", "low_ticks", "close_ticks", "volume_shares", "observed_minutes", "expected_minutes", "data_quality_state", "source_record_sequence_sha256"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "instrument_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "source_ticker": {"type": "string", "minLength": 1, "maxLength": 16},
    "session_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "trading_date": {"type": "string", "format": "date"},
    "open_ticks": {"type": "integer", "minimum": 1},
    "high_ticks": {"type": "integer", "minimum": 1},
    "low_ticks": {"type": "integer", "minimum": 1},
    "close_ticks": {"type": "integer", "minimum": 1},
    "volume_shares": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "observed_minutes": {"type": "integer", "minimum": 1},
    "expected_minutes": {"type": "integer", "minimum": 1},
    "data_quality_state": {"enum": ["VALID", "DEGRADED"]},
    "source_record_sequence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}

namespace aegis.mx.contracts.v1;

// Every identifier is an opaque, unsigned 128-bit value. All-zero is invalid
// unless a containing table explicitly documents that the field is optional.
struct VenueId {
  high:ulong;
  low:ulong;
}

struct InstrumentId {
  high:ulong;
  low:ulong;
}

struct ChannelId {
  high:ulong;
  low:ulong;
}

struct StrategyId {
  high:ulong;
  low:ulong;
}

struct ModelId {
  high:ulong;
  low:ulong;
}

struct ModelVersion {
  high:ulong;
  low:ulong;
}

struct OrderId {
  high:ulong;
  low:ulong;
}

struct IntentId {
  high:ulong;
  low:ulong;
}

struct ForecastId {
  high:ulong;
  low:ulong;
}

struct FeatureSnapshotId {
  high:ulong;
  low:ulong;
}

struct RiskSnapshotId {
  high:ulong;
  low:ulong;
}

struct ConfigurationVersion {
  high:ulong;
  low:ulong;
}

struct GlobalEventId {
  high:ulong;
  low:ulong;
}

struct SessionId {
  high:ulong;
  low:ulong;
}

// Added in v1.6 for account-scoped risk and kill-switch authorization.
struct AccountId {
  high:ulong;
  low:ulong;
}

// Semantic compatibility is governed by major/minor. Patch identifies a
// clarification or implementation revision that does not alter the wire.
struct SchemaVersion {
  major:ushort;
  minor:ushort;
  patch:uint;
}

// SHA-256 bytes in network/display order. Hex rendering is bytes[0] first.
struct Sha256Digest {
  bytes:[ubyte:32];
}

// Nanoseconds since 1970-01-01T00:00:00 UTC, originating at the venue.
struct ExchangeEventTimeNs {
  value:long;
}

// Nanoseconds since Unix epoch captured by a synchronized NIC hardware clock.
struct NicReceiveTimeNs {
  value:long;
}

// Nanoseconds from the process monotonic clock's session-local origin.
struct ProcessMonotonicTimeNs {
  value:ulong;
}

// Nanoseconds since 1970-01-01T00:00:00 UTC from the local wall clock.
struct WallClockUtcTimeNs {
  value:long;
}

enum PriceUnit : ubyte {
  UNKNOWN = 0,
  TICKS = 1
}

enum QuantityUnit : ubyte {
  UNKNOWN = 0,
  INSTRUMENT_UNITS = 1
}

enum CurrencyUnit : ubyte {
  UNKNOWN = 0,
  CURRENCY_NANOS = 1
}

enum BookSide : ubyte {
  UNKNOWN = 0,
  BID = 1,
  ASK = 2
}

enum TradeSide : ubyte {
  UNKNOWN = 0,
  BUY = 1,
  SELL = 2,
  NOT_APPLICABLE = 3
}

enum BookAction : ubyte {
  UNKNOWN = 0,
  ADD = 1,
  CHANGE = 2,
  DELETE = 3,
  CLEAR_SIDE = 4,
  CLEAR_BOOK = 5
}

enum TradingStatusCode : ubyte {
  UNKNOWN = 0,
  PRE_OPEN = 1,
  OPEN = 2,
  HALTED = 3,
  AUCTION = 4,
  CLOSED = 5
}

enum DataQualityCode : ubyte {
  UNKNOWN = 0,
  VALID = 1,
  DEGRADED = 2,
  STALE = 3,
  INVALID = 4
}

enum ClockQualityCode : ubyte {
  UNKNOWN = 0,
  SYNCHRONIZED = 1,
  HOLDOVER = 2,
  UNSYNCHRONIZED = 3,
  INVALID = 4
}

enum ForecastUnit : ubyte {
  UNKNOWN = 0,
  RETURN_TICKS = 1,
  FAIR_VALUE_TICKS = 2,
  PROBABILITY_PPM = 3,
  QUANTITY_UNITS = 4,
  // Signed expected return in parts per million. Added in schema v1.1.
  RETURN_PPM = 5,
  // Additive v1.3 units for explicitly typed time-series targets.
  VOLATILITY_PPM = 6,
  VOLUME_UNITS = 7,
  SPREAD_TICKS = 8,
  FACTOR_PPM = 9
}

enum ForecastTarget : ubyte {
  UNKNOWN = 0,
  RETURN = 1,
  REALIZED_VOLATILITY = 2,
  VOLUME = 3,
  SPREAD = 4,
  MARKET_FACTOR = 5,
  SECTOR_FACTOR = 6
}

// Additive v1.9 semantic forecast-horizon vocabulary. UNKNOWN is unsafe.
// ELAPSED_NANOSECONDS exists only to make legacy horizon_ns records explicit;
// POC writers use TRADING_MINUTES or TRADING_SESSIONS.
enum ForecastHorizonUnit : ubyte {
  UNKNOWN = 0,
  ELAPSED_NANOSECONDS = 1,
  TRADING_MINUTES = 2,
  TRADING_SESSIONS = 3
}

enum HorizonHaltPolicy : ubyte {
  UNKNOWN = 0,
  NOT_APPLICABLE = 1,
  REJECT = 2,
  PAUSE = 3,
  COUNT_SCHEDULED = 4
}

enum HorizonSessionEndpoint : ubyte {
  UNKNOWN = 0,
  NOT_APPLICABLE = 1,
  REGULAR_SESSION_CLOSE = 2
}

enum IntentAction : ubyte {
  UNKNOWN = 0,
  BUY = 1,
  SELL = 2,
  CANCEL = 3
}

enum RiskDecisionCode : ubyte {
  UNKNOWN = 0,
  REJECTED = 1,
  APPROVED = 2
}


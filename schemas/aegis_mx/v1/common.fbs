  EXPIRED_INTENT = 9,
  TRADING_MODE_UNAUTHORIZED = 10,
  OPERATOR_SESSION_UNAUTHORIZED = 11,
  STRATEGY_UNAUTHORIZED = 12,
  SYMBOL_UNAUTHORIZED = 13,
  RESTRICTED_INSTRUMENT = 14,
  MARKET_STATE_UNSAFE = 15,

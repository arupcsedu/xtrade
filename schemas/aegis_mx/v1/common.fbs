  ORDER_QUANTITY_EXCEEDED = 18,
  ORDER_NOTIONAL_EXCEEDED = 19,
  PRICE_COLLAR_EXCEEDED = 20,
  INVALID_TICK_SIZE = 21,
  DUPLICATE_INTENT = 22,
  ORDER_RATE_EXCEEDED = 23,
  CANCEL_RATE_EXCEEDED = 24,
  SYMBOL_POSITION_EXCEEDED = 25,
  GROSS_EXPOSURE_EXCEEDED = 26,
  NET_EXPOSURE_EXCEEDED = 27,
  SECTOR_CONCENTRATION_EXCEEDED = 28,
  FACTOR_EXPOSURE_EXCEEDED = 29,
  DAILY_LOSS_EXCEEDED = 30,
  STRATEGY_LOSS_EXCEEDED = 31,
  DRAWDOWN_EXCEEDED = 32,
  CREDIT_CAPITAL_EXCEEDED = 33,
  SHORT_SALE_LOCATE_DENIED = 34,
  SELF_TRADE_PREVENTION_DENIED = 35,
  VENUE_UNAUTHORIZED = 36,
  CONFIGURATION_STALE = 37,
  STALE_POSITION = 38,
  RISK_STATE_UNAVAILABLE = 39,
  CONFIGURATION_ROLLBACK = 40,
  SPLIT_BRAIN_EPOCH = 41,
  ARITHMETIC_OVERFLOW = 42,
  JOURNAL_UNAVAILABLE = 43,
  ENGINE_BUSY = 44
}


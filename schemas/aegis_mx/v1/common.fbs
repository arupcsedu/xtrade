// Additive v1.5 ensemble contract enums. UNKNOWN is always invalid for a v1.5
// writer and remains the fail-safe scalar default for older/malformed data.
enum EnsembleGateKind : ubyte {
  UNKNOWN = 0,
  RULE_BASED = 1,
  LINEAR = 2,
  QUANTIZED_LEARNED = 3
}


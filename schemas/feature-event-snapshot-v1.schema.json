{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis-mx.invalid/schemas/feature-event-snapshot-v1.schema.json",
  "title": "Aegis-MX point-in-time feature event snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "coverage",
    "economic_value_claimed",
    "events",
    "live_trading_capable",
    "schema_version",
    "snapshot_sha256",
    "source_manifest_ids",
    "source_report_sha256s",
    "source_universe_snapshot_sha256",
    "universe_snapshot_sha256"
  ],
  "properties": {
    "coverage": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"$ref": "#/$defs/coverage"}
    },
    "economic_value_claimed": {"const": false},
    "events": {
      "type": "array",
      "maxItems": 1000000,
      "items": {"$ref": "#/$defs/event"}
    },
    "live_trading_capable": {"const": false},
    "schema_version": {"const": "1.0.0"},
    "snapshot_sha256": {"$ref": "#/$defs/sha256"},
    "source_manifest_ids": {
      "type": "array",
      "maxItems": 20000,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?:sec|alfred)-[0-9a-f]{64}$"
      }
    },
    "source_report_sha256s": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/sha256"}
    },
    "source_universe_snapshot_sha256": {"$ref": "#/$defs/sha256"},
    "universe_snapshot_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ns": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "end_time_ns",
        "kind",
        "source_id",
        "source_snapshot_sha256",
        "start_time_ns"
      ],
      "properties": {
        "end_time_ns": {"$ref": "#/$defs/ns"},
        "kind": {"enum": ["NEWS", "MACRO"]},
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "source_snapshot_sha256": {"$ref": "#/$defs/sha256"},
        "start_time_ns": {"$ref": "#/$defs/ns"}
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available_at_ns",
        "event_time_ns",
        "instrument_id",
        "kind",
        "record_id",
        "revision_id",
        "source_sha256",
        "valid_until_ns"
      ],
      "properties": {
        "available_at_ns": {"$ref": "#/$defs/ns"},
        "event_time_ns": {"$ref": "#/$defs/ns"},
        "instrument_id": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{32}$"
        },
        "kind": {"enum": ["NEWS", "MACRO"]},
        "record_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "revision_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "valid_until_ns": {"$ref": "#/$defs/ns"}
      }
    }
  }
}

{
  "$id": "https://aegis-mx.invalid/schemas/alpaca-paper-system-path-evidence-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "build_version": {"minLength": 1, "type": "string"},
    "buy_only": {"const": true},
    "client_order_id": {"pattern": "^[0-9a-f]{32}$", "type": "string"},
    "fresh_pretrade_risk_required": {"const": true},
    "gateway_audit_hash": {"$ref": "#/$defs/positiveUint64"},
    "gateway_audit_sequence": {"$ref": "#/$defs/positiveUint64"},
    "gateway_configuration_hash": {"$ref": "#/$defs/positiveUint64"},
    "gateway_final_gate_accepted": {"const": true},
    "gateway_outbound_sequence": {"$ref": "#/$defs/positiveUint64"},
    "gateway_request_hash": {"$ref": "#/$defs/positiveUint64"},
    "instrument_id_high": {"$ref": "#/$defs/positiveUint64"},
    "instrument_id_low": {"$ref": "#/$defs/positiveUint64"},
    "live_trading_compiled": {"const": false},
    "mode": {"const": "PAPER"},
    "oms_command_hash": {"$ref": "#/$defs/positiveUint64"},
    "oms_command_valid": {"const": true},
    "oms_configuration_hash": {"$ref": "#/$defs/positiveUint64"},
    "oms_journal_sequence": {"$ref": "#/$defs/positiveUint64"},
    "paper_mode": {"const": true},
    "price_increment_currency_nanos": {"const": 10000000},
    "price_ticks": {"const": 1},
    "quantity_units": {"const": 1},
    "regular_hours_only": {"const": true},
    "risk_approved": {"const": true},
    "risk_context_hash": {"$ref": "#/$defs/positiveUint64"},
    "risk_decision_hash": {"$ref": "#/$defs/positiveUint64"},
    "risk_journal_sequence": {"$ref": "#/$defs/positiveUint64"},
    "risk_snapshot_hash": {"$ref": "#/$defs/positiveUint64"},
    "router_configuration_hash": {"$ref": "#/$defs/positiveUint64"},
    "routing_decision_hash": {"$ref": "#/$defs/positiveUint64"},
    "routing_request_hash": {"$ref": "#/$defs/positiveUint64"},
    "schema_version": {"const": "1.0.0"},
    "stable_hash": {"$ref": "#/$defs/positiveUint64"},
    "stage": {"const": "COMPLETE"},
    "symbol": {
      "maxLength": 16,
      "pattern": "^[A-Z][A-Z0-9]*(?:[.-][A-Z0-9]+)?$",
      "type": "string"
    }
  },
  "required": [
    "build_version",
    "buy_only",
    "client_order_id",
    "fresh_pretrade_risk_required",
    "gateway_audit_hash",
    "gateway_audit_sequence",
    "gateway_configuration_hash",
    "gateway_final_gate_accepted",
    "gateway_outbound_sequence",
    "gateway_request_hash",
    "instrument_id_high",
    "instrument_id_low",
    "live_trading_compiled",
    "mode",
    "oms_command_hash",
    "oms_command_valid",
    "oms_configuration_hash",
    "oms_journal_sequence",
    "paper_mode",
    "price_increment_currency_nanos",
    "price_ticks",
    "quantity_units",
    "regular_hours_only",
    "risk_approved",
    "risk_context_hash",
    "risk_decision_hash",
    "risk_journal_sequence",
    "risk_snapshot_hash",
    "router_configuration_hash",
    "routing_decision_hash",
    "routing_request_hash",
    "schema_version",
    "stable_hash",
    "stage",
    "symbol"
  ],
  "title": "Aegis-MX Alpaca PAPER deterministic command-path evidence v1",
  "type": "object",
  "$defs": {
    "positiveUint64": {
      "maximum": 18446744073709551615,
      "minimum": 1,
      "type": "integer"
    }
  }
}

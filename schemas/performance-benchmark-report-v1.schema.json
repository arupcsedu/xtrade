{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis-mx.invalid/schemas/performance-benchmark-report-v1.schema.json",
  "title": "Aegis-MX performance benchmark report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_schema_version",
    "suite_id",
    "mode",
    "measurement_source",
    "seed",
    "configuration_sha256",
    "code_commit",
    "environment",
    "methodology",
    "measurements",
    "raw_samples"
  ],
  "properties": {
    "report_schema_version": {"const": 1},
    "suite_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "mode": {"enum": ["SIMULATION", "PAPER"]},
    "measurement_source": {
      "enum": ["IN_PROCESS_SYNTHETIC", "REAL_NIC_CAPTURE"]
    },
    "seed": {"type": "integer", "minimum": 1},
    "configuration_sha256": {"$ref": "#/$defs/sha256"},
    "code_commit": {"type": "string", "minLength": 1, "maxLength": 128},
    "environment": {"$ref": "#/$defs/environment"},
    "methodology": {"$ref": "#/$defs/methodology"},
    "measurements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {"$ref": "#/$defs/measurement"}
    },
    "raw_samples": {"$ref": "#/$defs/rawSamples"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hostname",
        "operating_system",
        "kernel",
        "cpu_model",
        "logical_cpu_count",
        "pinned_cpu",
        "thread_pinning_verified",
        "build_type",
        "compiler"
      ],
      "properties": {
        "hostname": {"type": "string", "minLength": 1, "maxLength": 256},
        "operating_system": {"type": "string", "minLength": 1, "maxLength": 256},
        "kernel": {"type": "string", "minLength": 1, "maxLength": 256},
        "cpu_model": {"type": "string", "minLength": 1, "maxLength": 512},
        "logical_cpu_count": {"type": "integer", "minimum": 1},
        "pinned_cpu": {"type": "integer", "minimum": 0},
        "thread_pinning_verified": {"type": "boolean"},
        "numa_node": {"type": ["integer", "null"], "minimum": 0},
        "cpu_governor": {"type": ["string", "null"], "maxLength": 128},
        "build_type": {"enum": ["Release", "RelWithDebInfo"]},
        "compiler": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "methodology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "warmup_iterations",
        "samples_per_latency_case",
        "clock",
        "caches_warmed",
        "allocation_probe_enabled",
        "hardware_cache_misses_available",
        "hardware_cache_misses_unavailable_reason",
        "qualified_sample_count"
      ],
      "properties": {
        "warmup_iterations": {"type": "integer", "minimum": 1},
        "samples_per_latency_case": {"type": "integer", "minimum": 1},
        "clock": {"const": "CLOCK_MONOTONIC_RAW"},
        "caches_warmed": {"const": true},
        "allocation_probe_enabled": {"type": "boolean"},
        "hardware_cache_misses_available": {"type": "boolean"},
        "hardware_cache_misses_unavailable_reason": {
          "type": ["string", "null"],
          "maxLength": 512
        },
        "qualified_sample_count": {"type": "boolean"}
      }
    },
    "latency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["p50", "p95", "p99", "p99_9", "maximum"],
      "properties": {
        "p50": {"type": "integer", "minimum": 0},
        "p95": {"type": "integer", "minimum": 0},
        "p99": {"type": "integer", "minimum": 0},
        "p99_9": {"type": "integer", "minimum": 0},
        "maximum": {"type": "integer", "minimum": 0}
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario",
        "stage",
        "status",
        "sample_count",
        "latency_ns",
        "throughput_events_per_second",
        "cpu_utilization_ppm",
        "allocations",
        "cache_misses",
        "cache_misses_unavailable_reason",
        "queue_capacity",
        "queue_high_watermark",
        "packet_drops",
        "operation_count",
        "notes"
      ],
      "properties": {
        "scenario": {"type": "string", "minLength": 1, "maxLength": 64},
        "stage": {"type": "string", "minLength": 1, "maxLength": 96},
        "status": {"enum": ["MEASURED", "SAFETY_BLOCKED", "UNAVAILABLE"]},
        "sample_count": {"type": "integer", "minimum": 0},
        "latency_ns": {"oneOf": [{"$ref": "#/$defs/latency"}, {"type": "null"}]},
        "throughput_events_per_second": {"type": ["number", "null"], "minimum": 0},
        "cpu_utilization_ppm": {"type": ["integer", "null"], "minimum": 0},
        "allocations": {"type": ["integer", "null"], "minimum": 0},
        "cache_misses": {"type": ["integer", "null"], "minimum": 0},
        "cache_misses_unavailable_reason": {
          "type": ["string", "null"],
          "maxLength": 512
        },
        "queue_capacity": {"type": ["integer", "null"], "minimum": 1},
        "queue_high_watermark": {"type": ["integer", "null"], "minimum": 0},
        "packet_drops": {"type": "integer", "minimum": 0},
        "operation_count": {"type": "integer", "minimum": 0},
        "notes": {
          "type": "array",
          "maxItems": 16,
          "items": {"type": "string", "maxLength": 512}
        }
      }
    },
    "rawSamples": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "format", "record_count"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 4096},
        "sha256": {"$ref": "#/$defs/sha256"},
        "format": {"const": "aegis-performance-samples-v1-ndjson"},
        "record_count": {"type": "integer", "minimum": 1}
      }
    }
  }
}

{
  "profile_schema_version": 1,
  "name": "paper",
  "trading_mode": "PAPER",
  "live_transmission_enabled": false,
  "automatic_activation": false,
  "signed_runtime_configuration_required": true,
  "paths": {
    "release_root": "/opt/aegis-mx/releases",
    "current_symlink": "/opt/aegis-mx/current",
    "configuration_path": "/etc/aegis-mx/config/paper.signed.json",
    "state_root": "/var/lib/aegis-mx",
    "journal_root": "/var/lib/aegis-mx/journal",
    "log_root": "/var/log/aegis-mx",
    "runtime_root": "/run/aegis-mx"
  },
  "resources": {
    "numa_node": 0,
    "dedicated_cpu_sets": true,
    "hugepage_size_kb": 2048,
    "hugepage_count": 1024,
    "memory_lock_bytes": 2147483648,
    "file_descriptor_limit": 262144,
    "cpu_affinity": {"ptp": "2", "journal": "3", "edge-core": "4-11", "paper-gateway": "12", "observability": "13"}
  },
  "nic": {"interface": "enp1s0f0", "hardware_timestamping_required": true, "rx_queue_count_required": 4, "queue_assignments": {"market-data-a": [0], "market-data-b": [1], "gateway": [2], "drop-copy": [3]}},
  "ptp": {"required": true, "ptp4l_unit": "ptp4l.service", "phc2sys_unit": "phc2sys.service", "maximum_clock_quality_age_ns": 1000000000, "maximum_absolute_offset_ns": 500},
  "health": {"status_root": "/run/aegis-mx/health", "maximum_status_age_ns": 2000000000},
  "journal": {"filesystem": "xfs", "dedicated_device_required": true, "direct_io_preferred": true, "segment_bytes": 67108864, "sync_policy": "PERIODIC", "retention_days": 30}
}
